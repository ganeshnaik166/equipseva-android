{
  "$comment": "Cross-layer contract between the Android r3820 photo-evidence client and the round3821 register_evidence server rules. Read by app/src/test/.../RepairPhotoEvidenceContractTest.kt (Kotlin drives the REAL RepairJobDetailViewModel path builder and EvidenceRegisterPayload) and by supabase/tests/evidence_client_contract.test.mjs (Node executes these receipts against the ACTUAL round492 and round3821 SQL on PGlite). Edit here first; both sides must agree with this file.",
  "version": 1,
  "source_of_truth": {
    "client_path_builder": "app/src/main/kotlin/com/equipseva/app/features/repair/RepairJobDetailViewModel.kt — submitCheckinWithProof (before-) and submitCompletionProof (after-): objectPath = \"$uid/${job.id}/<prefix>-${System.currentTimeMillis()}-${UUID.randomUUID()}-${fileName.take(40).replace(Regex(\"[^A-Za-z0-9._-]\"), \"_\")}\"",
    "client_storage_url": "app/src/main/kotlin/com/equipseva/app/core/sync/handlers/EvidenceRegisterPayload.kt — forUploadedPhoto: storageUrl = \"${receipt.bucket}/${receipt.objectPath}\"",
    "client_rpc_call": "app/src/main/kotlin/com/equipseva/app/core/sync/handlers/EvidenceRegisterOutboxHandler.kt — ten p_* parameters, metadata {mime_type, captured_from, client}",
    "server_rules": "supabase/migrations/20263898000000_round3821_evidence_authorization.sql lines 50-133 (non-service path)",
    "server_baseline": "supabase/migrations/20260811000000_round492_evidence_65b_chain.sql (what production runs today; no storage_url validation)"
  },
  "uid_source": "Client uses session.user.id (SupabaseAuthRepository) for the first path segment; the server compares string_to_array(p_storage_url,'/')[2] with auth.uid()::text (the JWT sub). Their equality is a GoTrue invariant assumed by both test sides and observed only by the DEV-01 device drive.",
  "rules": {
    "bucket": "repair-photos",
    "segment_count": 4,
    "uuid_regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "filename_regex": "^[A-Za-z0-9._-]+$",
    "filename_forbidden": [".", ".."],
    "storage_url_regex": "^repair-photos/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(?!\\.\\.?$)[A-Za-z0-9._-]+$",
    "client_stored_name_regex": "^(before|after)-[0-9]+-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-[A-Za-z0-9._-]{0,40}$",
    "content_sha256_regex": "^[0-9a-f]{64}$",
    "content_size_min": 1,
    "evidence_kinds": ["photo_before", "photo_after"],
    "source_kind": "repair_job",
    "producer_kind": "engineer",
    "metadata_keys": ["mime_type", "captured_from", "client"],
    "metadata_captured_from": "upload_time",
    "metadata_client": "android",
    "platform_version_regex": "^android/[0-9]+\\.[0-9]+\\.[0-9]+(-debug)?$",
    "sanitizer": {
      "take": 40,
      "replace_regex": "[^A-Za-z0-9._-]",
      "replacement": "_",
      "order": "take(40) first, then replace"
    },
    "server_sqlstates": {
      "evidence_kind_not_authorized": "42501",
      "evidence_object_not_authorized": "42501",
      "evidence_photo_not_attached": "42501",
      "evidence_object_not_found": "02000",
      "evidence_object_size_mismatch": "22023",
      "evidence_registration_conflict": "42501",
      "evidence_registration_retry": "40001",
      "not_assigned_engineer": "42501",
      "repair_job_not_found": "02000",
      "content_sha256_invalid": "22023"
    }
  },
  "sanitizer_table": [
    { "input": "IMG 2026-09-09 (1).jpg", "expected": "IMG_2026-09-09__1_.jpg", "why": "spaces and parentheses become underscores" },
    { "input": "café.jpg", "expected": "caf_.jpg", "why": "one precomposed non-ASCII code unit becomes one underscore" },
    { "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.jpg", "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "why": "45 a's + .jpg: take(40) runs BEFORE the replace, so the extension is cut" },
    { "input": "", "expected": "", "why": "blank name leaves a trailing '-' on the stored name, which the server filename regex still accepts" },
    { "input": "../x.jpg", "expected": ".._x.jpg", "why": "a picker filename cannot inject a fifth path segment or a '..' segment" },
    { "input": "photo/with/slash.jpg", "expected": "photo_with_slash.jpg", "why": "slashes become underscores" },
    { "input": "sp ace.PNG", "expected": "sp_ace.PNG", "why": "case is preserved; only disallowed characters change" }
